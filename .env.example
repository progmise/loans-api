# ─── Local (docker-compose) ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/LOAN_API
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ─── Supabase (PostgreSQL) ─────────────────────────────────────────────────
# Use the pooler or direct connection string from Project Settings > Database.
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<supabase-db-password>

# ─── Upstash (Redis over TLS) ──────────────────────────────────────────────
# Values from Upstash console > Database > Connect.
# REDIS_HOST=<endpoint>.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=<upstash-token>
# REDIS_SSL=true

# ─── Cache ─────────────────────────────────────────────────────────────────
CACHE_USERS_NAME=users
CACHE_USERS_TTL=300

# ─── Sentry (optional — disabled when unset) ──────────────────────────────
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENABLED=true

# ─── Server ────────────────────────────────────────────────────────────────
# PORT=8080
